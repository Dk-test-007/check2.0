<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Lost_Reason_Validation_CC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(StageName, &quot;Closed Lost&quot;),
    ISBLANK(TEXT(Loss_Reason_CC__c)),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Opportunity.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Loss_Reason_CC__c</errorDisplayField>
    <errorMessage>Loss Reason is required for marking Opportunity as Closed Lost.</errorMessage>
</ValidationRule>
