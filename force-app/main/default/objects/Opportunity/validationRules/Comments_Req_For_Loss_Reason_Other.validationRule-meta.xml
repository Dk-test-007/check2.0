<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Comments_Req_For_Loss_Reason_Other</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Loss_Reason_CC__c),
    ISPICKVAL(Loss_Reason_CC__c, &quot;Other&quot;),
    ISBLANK(Closed_Lost_Comments_CC__c),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Opportunity.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Closed_Lost_Comments_CC__c</errorDisplayField>
    <errorMessage>If Loss Reason is Other, please provide Closed Lost Comments.</errorMessage>
</ValidationRule>
