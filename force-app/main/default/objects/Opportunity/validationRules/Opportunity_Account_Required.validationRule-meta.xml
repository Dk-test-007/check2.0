<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Opportunity_Account_Required</fullName>
    <active>true</active>
    <description>Every Opportunity must be associated with an Account.</description>
    <errorConditionFormula>AND(
				NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Opportunity.Bypass_Validation_CC__c),
				$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
				ISBLANK(AccountId)
)</errorConditionFormula>
    <errorMessage>Opportunity must be associated with an Account.</errorMessage>
</ValidationRule>
