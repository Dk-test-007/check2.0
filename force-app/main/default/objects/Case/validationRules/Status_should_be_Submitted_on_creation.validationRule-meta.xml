<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_should_be_Submitted_on_creation</fullName>
    <active>true</active>
    <errorConditionFormula>AND (
    ISNEW(),
    RecordType.DeveloperName == &quot;RFQ&quot;,
    NOT(ISPICKVAL(Status, &quot;Submitted&quot;)),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Case.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Status</errorDisplayField>
    <errorMessage>RFQ can only be created with &quot;Submitted&quot; Status .</errorMessage>
</ValidationRule>
