<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Closed_RFQ_Updates_to_Admins</fullName>
    <active>true</active>
    <description>Only administrative users should be allowed to make updates to closed RFQ</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName == &quot;RFQ&quot;,
    IsClosed,
    PRIORVALUE(IsClosed),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Case.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorMessage>Only administrative users are allowed to update a closed RFQ.</errorMessage>
</ValidationRule>
