<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Opportunity_Update_on_a_RFQ</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    RecordType.DeveloperName == &quot;RFQ&quot;,
    NOT(ISNEW()),
    ISCHANGED(Opportunity__c),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Case.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Opportunity__c</errorDisplayField>
    <errorMessage>Opportunity cannot be changed once assigned to an RFQ Case.</errorMessage>
</ValidationRule>
