<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DetailsRequiredForOtherCancelledReason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Cancelled_Reason__c, &apos;Other&apos;),
    ISBLANK(Cancelled_Reason_Detail__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Quote.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorDisplayField>Cancelled_Reason_Detail__c</errorDisplayField>
    <errorMessage>Please add additional details for Cancellation Reason</errorMessage>
</ValidationRule>
