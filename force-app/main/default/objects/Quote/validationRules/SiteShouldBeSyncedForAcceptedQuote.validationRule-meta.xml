<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SiteShouldBeSyncedForAcceptedQuote</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL( Status, &quot;Accepted&quot;),
    NOT(Ship_to_Site_CC__r.Site_Synced_CC__c),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Quote.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Ship_to_Site_CC__c</errorDisplayField>
    <errorMessage>Site should be synced before marking the Quote Accepted</errorMessage>
</ValidationRule>
