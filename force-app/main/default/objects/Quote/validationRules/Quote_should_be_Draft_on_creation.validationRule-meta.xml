<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quote_should_be_Draft_on_creation</fullName>
    <active>true</active>
    <errorConditionFormula>AND (
    ISNEW(),
    NOT(ISPICKVAL(Status, &quot;Draft&quot;)),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Quote.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Status</errorDisplayField>
    <errorMessage>Quote can only be created in &quot;Draft&quot; Status.</errorMessage>
</ValidationRule>
