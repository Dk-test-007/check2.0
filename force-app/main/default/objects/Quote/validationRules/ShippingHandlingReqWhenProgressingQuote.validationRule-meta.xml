<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ShippingHandlingReqWhenProgressingQuote</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL(PRIORVALUE(Status), &quot;Draft&quot;),
    ISBLANK(ShippingHandling),
	NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Quote.Bypass_Validation_CC__c),
	$Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>ShippingHandling</errorDisplayField>
    <errorMessage>Shipping and Handling information is required when progressing on Quote</errorMessage>
</ValidationRule>
