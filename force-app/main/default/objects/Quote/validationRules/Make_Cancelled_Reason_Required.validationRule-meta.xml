<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Make_Cancelled_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &apos;Cancelled&apos;),
    ISBLANK(TEXT(Cancelled_Reason__c)),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Quote.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorDisplayField>Cancelled_Reason__c</errorDisplayField>
    <errorMessage>Please update the Cancelled Reason for marking the Quote as Cancelled</errorMessage>
</ValidationRule>
