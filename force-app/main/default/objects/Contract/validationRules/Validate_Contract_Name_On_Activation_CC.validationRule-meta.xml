<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Contract_Name_On_Activation_CC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL(Status, &quot;Active&quot;),
    ISBLANK(Name),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Contract.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorMessage>Contract Name cannot be blank when activating the Contract.</errorMessage>
</ValidationRule>
