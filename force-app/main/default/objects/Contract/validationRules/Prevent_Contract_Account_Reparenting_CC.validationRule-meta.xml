<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Contract_Account_Reparenting_CC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(AccountId),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Contract.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorMessage>The Account associated with a Contract cannot be changed after creation.</errorMessage>
</ValidationRule>
