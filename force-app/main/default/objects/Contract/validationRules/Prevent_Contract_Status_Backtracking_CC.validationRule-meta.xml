<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Contract_Status_Backtracking_CC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL(PRIORVALUE(Status), &quot;Active&quot;),
    ISPICKVAL(Status, &quot;Draft&quot;),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Contract.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorMessage>Contract status cannot be moved backward.</errorMessage>
</ValidationRule>
