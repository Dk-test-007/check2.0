<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Quantity_To_Next_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Quantity_To_Next_Order_CC__c)),
    OR(
        Quantity_To_Next_Order_CC__c &lt; 0,
        Quantity_To_Next_Order_CC__c &gt; Remaining_SKU_CC__c
    )
)</errorConditionFormula>
    <errorMessage>Quantity to Next Order must be greater than 0 and cannot exceed the Remaining SKU.</errorMessage>
</ValidationRule>
