<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MOQ_Required_Validation_CC</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(MOQ_Required_CC__c, &quot;Yes&quot;),
    OR(
        ISBLANK(Minimum_Order_Quantity_CC__c),
        Minimum_Order_Quantity_CC__c &lt;= 0
    )
)</errorConditionFormula>
    <errorMessage>Minimum Order Quantity must be defined when MOQ Required is checked.</errorMessage>
</ValidationRule>
