<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Entity_Parent_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Entity&apos;,ParentId!=null ,
Parent.RecordType.Name != &apos;Corporate Group&apos;,
NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Account.Bypass_Validation_CC__c),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorMessage>Entities can only have Corporate Groups as Parents</errorMessage>
</ValidationRule>
