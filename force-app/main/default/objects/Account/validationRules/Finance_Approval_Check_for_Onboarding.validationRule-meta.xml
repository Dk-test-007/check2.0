<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Finance_Approval_Check_for_Onboarding</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Financial_Check_CC__c),
    NOT(ISPICKVAL(Client_Onboarding_Status_CC__c, &quot;Completed&quot;)),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Account.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorMessage>Cannot start Financial Check before Client Onboarding is not Completed</errorMessage>
</ValidationRule>
