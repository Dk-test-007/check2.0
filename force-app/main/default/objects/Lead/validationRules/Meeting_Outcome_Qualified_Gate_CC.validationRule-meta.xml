<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Meeting_Outcome_Qualified_Gate_CC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Qualified&quot;),
    ISBLANK(TEXT(Meeting_Outcome_CC__c)),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Lead.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Meeting_Outcome_CC__c</errorDisplayField>
    <errorMessage>Meeting Outcome is required to save the record</errorMessage>
</ValidationRule>
