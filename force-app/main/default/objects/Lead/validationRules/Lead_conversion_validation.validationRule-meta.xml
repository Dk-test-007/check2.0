<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_conversion_validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    IsConverted,
    NOT(ISPICKVAL(PRIORVALUE(Status), &quot;Qualified&quot;)),
				NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Lead.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorMessage>Only Sales Qualified leads can be converted.</errorMessage>
</ValidationRule>
