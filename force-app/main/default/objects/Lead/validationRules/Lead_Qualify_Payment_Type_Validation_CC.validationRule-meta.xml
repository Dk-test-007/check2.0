<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Qualify_Payment_Type_Validation_CC</fullName>
    <active>false</active>
    <description>Prevent Qualify stage if Account Type is Empty</description>
    <errorConditionFormula>AND(
				NOT(ISPICKVAL(PRIORVALUE(Status), &quot;Disqualified&quot;)),
    ISCHANGED(Status),
    ISPICKVAL(Status, &quot;Qualify&quot;),
    ISBLANK(TEXT(Requested_Payment_Type_CC__c)),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Lead.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorDisplayField>Requested_Payment_Type_CC__c</errorDisplayField>
    <errorMessage>Requested Payment Type (Cash or Credit) must be selected before the Lead can be moved to Qualify.</errorMessage>
</ValidationRule>
