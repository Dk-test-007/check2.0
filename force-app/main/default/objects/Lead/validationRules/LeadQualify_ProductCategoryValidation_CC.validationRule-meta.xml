<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LeadQualify_ProductCategoryValidation_CC</fullName>
    <active>true</active>
    <description>Prevent Qualify stage without filling Product Category.</description>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL(Status, &quot;Qualified&quot;),
    ISBLANK(Product_Category_Text_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Lead.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorDisplayField>Product_Category_CC__c</errorDisplayField>
    <errorMessage>Product Category must be populated before the Lead can be moved to Qualify.</errorMessage>
</ValidationRule>
