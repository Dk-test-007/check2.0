<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_import_validation_CC</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(LeadSource, &quot;Data Import&quot;),
    NOT($Permission.Lead_Import_Permission),
				NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Lead.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorDisplayField>LeadSource</errorDisplayField>
    <errorMessage>You can not import lead data</errorMessage>
</ValidationRule>
