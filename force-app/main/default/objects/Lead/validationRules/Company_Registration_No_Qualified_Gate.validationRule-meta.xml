<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Company_Registration_No_Qualified_Gate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Qualified&quot;),
    ISBLANK(Company_Registration_No_CC__c),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Lead.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Company_Registration_No_CC__c</errorDisplayField>
    <errorMessage>Company Registration Number is required to save the record.</errorMessage>
</ValidationRule>
