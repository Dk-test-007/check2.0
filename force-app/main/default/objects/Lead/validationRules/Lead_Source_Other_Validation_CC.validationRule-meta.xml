<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Source_Other_Validation_CC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    (ISPICKVAL( LeadSource , &quot;Other&quot;)),
    ISBLANK( Lead_Source_Other_CC__c ),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Lead.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorDisplayField>Lead_Source_Other_CC__c</errorDisplayField>
    <errorMessage>For Lead source Other. you need to provide the the lead source.</errorMessage>
</ValidationRule>
