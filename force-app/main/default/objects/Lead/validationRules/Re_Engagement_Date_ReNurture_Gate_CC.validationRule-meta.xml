<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Re_Engagement_Date_ReNurture_Gate_CC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Re-Nurture&quot;),
    ISBLANK(Reengagement_Date_CC__c),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Lead.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Reengagement_Date_CC__c</errorDisplayField>
    <errorMessage>Re-Engagement Date is required to save the record</errorMessage>
</ValidationRule>
