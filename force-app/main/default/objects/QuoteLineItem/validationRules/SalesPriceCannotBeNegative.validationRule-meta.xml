<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SalesPriceCannotBeNegative</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(UnitPrice),
    UnitPrice &lt; 0,
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.QuoteLineItem.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorDisplayField>UnitPrice</errorDisplayField>
    <errorMessage>Sales Price cannot be less than zero.</errorMessage>
</ValidationRule>
