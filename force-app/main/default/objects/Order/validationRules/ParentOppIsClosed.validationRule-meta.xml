<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ParentOppIsClosed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    Opportunity.IsClosed,
    ISNEW(),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Order.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorMessage>Cannot create an Order because the related Opportunity is closed.</errorMessage>
</ValidationRule>
