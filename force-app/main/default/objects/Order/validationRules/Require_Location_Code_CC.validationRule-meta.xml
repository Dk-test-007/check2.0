<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Location_Code_CC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL(Status, &quot;Activated&quot;),
    ISBLANK(TEXT(Location_Code_CC__c)),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Order.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Location_Code_CC__c</errorDisplayField>
    <errorMessage>Enter Location Code before activating the Order.</errorMessage>
</ValidationRule>
