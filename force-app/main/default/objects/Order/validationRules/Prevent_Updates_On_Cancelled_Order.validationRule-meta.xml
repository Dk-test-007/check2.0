<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Updates_On_Cancelled_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(PRIORVALUE(Status), &quot;Cancelled&quot;),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
				NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Order.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorMessage>Cancelled Orders cannot be modified.</errorMessage>
</ValidationRule>
