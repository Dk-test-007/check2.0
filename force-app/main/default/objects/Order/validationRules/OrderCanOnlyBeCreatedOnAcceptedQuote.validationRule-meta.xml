<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OrderCanOnlyBeCreatedOnAcceptedQuote</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(QuoteId)),
    NOT(ISPICKVAL(Quote.Status, &quot;Accepted&quot;)),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Order.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorMessage>Order can only be created for Accepted Quote</errorMessage>
</ValidationRule>
