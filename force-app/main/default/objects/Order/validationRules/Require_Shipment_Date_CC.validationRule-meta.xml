<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Shipment_Date_CC</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL(Status, &quot;Activated&quot;),
    ISBLANK(Shipment_Date_CC__c),
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Order.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>Shipment_Date_CC__c</errorDisplayField>
    <errorMessage>Enter Shipment Date before activating the Order.</errorMessage>
</ValidationRule>
