<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Activated_Order_Backtracking_CC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(PRIORVALUE(Status), &quot;Activated&quot;),
    ISCHANGED(Status),
    NOT(ISPICKVAL(Status, &quot;Activated&quot;)),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Order.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorMessage>An Activated Order cannot be moved back to a previous status.</errorMessage>
</ValidationRule>
