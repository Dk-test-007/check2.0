<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BC_Status_CC__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
     NOT(ISBLANK(External_Id_CC__c)),
    &quot;Synced&quot;,
    &quot;Not Synced&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Synced = Order exists in Business Central. Not Synced = not yet sent or failed.</inlineHelpText>
    <label>BC Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
