<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_Phone_Max_Length</fullName>
    <active>true</active>
    <description>Prevents users from entering more than 15 characters in the Contact Phone field.</description>
    <errorConditionFormula>AND(
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Contact.Bypass_Validation_CC__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT(ISBLANK(Phone)),
    LEN(Phone) &gt; 15
)</errorConditionFormula>
    <errorMessage>Phone number cannot be more than 15 characters long.</errorMessage>
</ValidationRule>
