<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Number_Invalid_Characters</fullName>
    <active>true</active>
    <description>Prevents users from entering unsupported characters in the Phone field.</description>
    <errorConditionFormula>AND(
				NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Contact.Bypass_Validation_CC__c),
				$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT(ISBLANK(Phone)),
    NOT(REGEX(Phone,&quot;^[0-9 +().\\-/]*$&quot;))
)</errorConditionFormula>
    <errorMessage>Phone number contains invalid characters.</errorMessage>
</ValidationRule>
