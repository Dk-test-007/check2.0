<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CptOnlyAllowedToUpdateLandingPrice</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Name),
    $Profile.Name == &quot;Carlton CPT User&quot;,
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    NOT($CustomMetadata.Trigger_Framework_Config_CC__mdt.Product2.Bypass_Validation_CC__c)
)</errorConditionFormula>
    <errorMessage>CPT are only allowed to update &quot;Estimated Landing Price&quot; on a Product</errorMessage>
</ValidationRule>
