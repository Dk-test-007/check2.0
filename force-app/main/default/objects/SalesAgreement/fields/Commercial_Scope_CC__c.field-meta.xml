    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Entity-wide</fullName>
                <default>true</default>
                <label>Entity-wide</label>
            </value>
            <value>
                <fullName>Site-scoped</fullName>
                <default>false</default>
                <label>Site-scoped</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
