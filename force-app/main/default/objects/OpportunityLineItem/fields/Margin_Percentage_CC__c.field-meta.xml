<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Margin_Percentage_CC__c</fullName>
    <formula>IF(
UnitPrice = 0 ||  PricebookEntry.Product2.Estimated_Landing_Price_CC__c = 0,
0,
(UnitPrice - ROUND(PricebookEntry.Product2.Estimated_Landing_Price_CC__c, 2)) / UnitPrice
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Margin%</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Percent</type>
</CustomField>
